# pixstory server environment variables
# Copy this file to `.env` and fill in real values for local development.
# On Elastic Beanstalk, set these via `eb setenv KEY=value` instead.

PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (Driver -> Node.js)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pixstory?retryWrites=true&w=majority

# JWT secret — generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AWS credentials (an IAM user with s3:PutObject + s3:GetObject on the bucket)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# S3 bucket that stores uploaded images
S3_BUCKET=pixstory-uploads

# CloudFront distribution domain that serves images (e.g. d123abc.cloudfront.net)
# Required. Images are served from this CDN; the S3 bucket stays private and
# CloudFront reads it via Origin Access Control.
CLOUDFRONT_DOMAIN=d123abc.cloudfront.net

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
